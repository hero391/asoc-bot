# Set these as Railway service variables. Never commit actual secret values.
BOT_TOKEN=
QR_SECRET=
CHECKIN_PASSWORD=
CHECKIN_COOKIE_SECURE=true
DB_PATH=/data/aso.db

# Gmail: use a Google App Password (not your normal account password).
# For another provider, use its SMTP host and port (STARTTLS).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=ethiopiastrokefoundation@gmail.com
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=ethiopiastrokefoundation@gmail.com
EMAIL_FROM_NAME=ESF 2026 Comprehensive Stroke Care Symposium
